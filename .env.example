# Copy to .env (never commit .env) and export the values before running manage.py.
DJANGO_SECRET_KEY=change-me
# Set to 1 for local development only.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (omit POSTGRES_DB to fall back to SQLite for quick local work)
POSTGRES_DB=vacation_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
